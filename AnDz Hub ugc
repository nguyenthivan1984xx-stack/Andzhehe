-- =========================
-- TELE 1-4
-- =========================
for i = 1, 4 do

local tele = Instance.new("TextButton")  
tele.Name = "Tele" .. i  
tele.Size = UDim2.new(0, 210, 0, 40)  
tele.Position = UDim2.new(0, 10, 0, 50 + (i - 1) * 50)  
tele.BackgroundColor3 = Color3.fromRGB(105, 55, 170)  
tele.Text = "TELE " .. i  
tele.TextColor3 = Color3.fromRGB(255, 255, 255)  
tele.TextSize = 15  
tele.Font = Enum.Font.GothamBold  
tele.Parent = frame  

local teleCorner = Instance.new("UICorner")  
teleCorner.CornerRadius = UDim.new(0, 7)  
teleCorner.Parent = tele  

tele.MouseButton1Click:Connect(function()  

    local character = player.Character  
    local root = character and character:FindFirstChild("HumanoidRootPart")  

    if not root then  
        return  
    end  

    local pos = fixedPositions[i]  

    if not pos then  
        return  
    end  

    root.CFrame = CFrame.new(pos)  

    local oldCoordinate = gui:FindFirstChild("TeleportCoordinate")  

    if oldCoordinate then  
        oldCoordinate:Destroy()  
    end  

    local coordinate = Instance.new("TextLabel")  
    coordinate.Name = "TeleportCoordinate"  
    coordinate.Size = UDim2.new(0, 430, 0, 105)  
    coordinate.Position = UDim2.new(0.5, -215, 0.78, 0)  
    coordinate.BackgroundColor3 = Color3.fromRGB(38, 18, 55)  
    coordinate.BackgroundTransparency = 0.05  
    coordinate.TextColor3 = Color3.fromRGB(255, 255, 255)  
    coordinate.TextSize = 24  
    coordinate.Font = Enum.Font.GothamBold  
    coordinate.TextXAlignment = Enum.TextXAlignment.Center  
    coordinate.TextYAlignment = Enum.TextYAlignment.Center  

    coordinate.Text = string.format(  
        "📍 TELE %d\nX: %.1f    Y: %.1f    Z: %.1f",  
        i,  
        pos.X,  
        pos.Y,  
        pos.Z  
    )  

    coordinate.Parent = gui  

    local corner = Instance.new("UICorner")  
    corner.CornerRadius = UDim.new(0, 10)  
    corner.Parent = coordinate  

    local stroke = Instance.new("UIStroke")  
    stroke.Thickness = 3  
    stroke.Color = Color3.fromRGB(175, 70, 255)  
    stroke.Parent = coordinate  

    task.delay(2, function()  
        if coordinate and coordinate.Parent then  
            coordinate:Destroy()  
        end  
    end)  
end)

end

-- =========================
-- KIỂM TRA KEY
-- =========================
local function checkKey()
if keyBox.Text == CORRECT_KEY then

keyFrame.Visible = false  
    openButton.Visible = true  
    frame.Visible = true  

else  

    keyBox.Text = ""  
    keyBox.PlaceholderText = "❌ KEY SAI!"  

    task.delay(1.5, function()  
        if keyBox then  
            keyBox.PlaceholderText = "Nhập key..."  
        end  
    end)  

end

end

checkButton.MouseButton1Click:Connect(checkKey)

keyBox.FocusLost:Connect(function(enterPressed)
if enterPressed then
checkKey()
end
end)

-- =========================
-- ẨN / HIỆN MENU
-- =========================
openButton.MouseButton1Click:Connect(function()
frame.Visible = not frame.Visible
end)
