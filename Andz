local function setSpeed(x)
    local p = math.clamp(
        (x-bar.AbsolutePosition.X)/bar.AbsoluteSize.X,
        0,1
    )

    speed = math.clamp(math.floor(p*9+1.5),1,10)

    fill.Size = UDim2.new((speed-1)/9,0,1,0)
    speedText.Text = "✈️ TỐC ĐỘ BAY: "..speed
