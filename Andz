--==================================================
-- EGG
--==================================================

local saved = nil
local flying = false

local function root()
    return (
        player.Character or player.CharacterAdded:Wait()
    ):WaitForChild("HumanoidRootPart")
end

local function pos(v)
    if v:IsA("BasePart") then
        return v.Position
    elseif v:IsA("Model") then
        local ok,cf = pcall(function()
            return v:GetPivot()
        end)
        if ok then return cf.Position end
    end
end

local function container(v)
    while v and v ~= workspace do
        if v:IsA("Model") then return v end
        v = v.Parent
    end
end

local function eggs()
    local list,seen = {},{}

    for _,v in ipairs(workspace:GetDescendants()) do
        local found = false

        if string.find(v.Name:lower(),"egg",1,true) then
            found = true
        elseif v:IsA("TextLabel") or v:IsA("TextButton") then
            found = string.find(v.Text:lower(),"egg",1,true) ~= nil
        elseif v:IsA("ProximityPrompt") then
            found =
                v.ActionText:lower() == "steal"
                or string.find(v.ObjectText:lower(),"egg",1,true) ~= nil
        end

        if found then
            local m = container(v)
            if m and not seen[m] then
                seen[m] = true
                table.insert(list,m)
            end
        end
    end

    return list
end

--==================================================
-- BAY TỚI / BAY VỀ
--==================================================

local function fly(target,look)
    local r = root()
    flying = true

    local start = r.Position
    local time = 10/speed
    local t = tick()

    while flying and r.Parent do
        local a = math.clamp((tick()-t)/time,0,1)
        local s = a*a*(3-2*a)
        local p = start:Lerp(target,s)

        r.CFrame = CFrame.lookAt(p,look or target)
        r.AssemblyLinearVelocity = Vector3.zero
        r.AssemblyAngularVelocity = Vector3.zero

        if a >= 1 then break end
        task.wait(.03)
    end

    if r.Parent and flying then
        r.CFrame = CFrame.lookAt(target,look or target)
    end

    flying = false
    return true
end

tele.MouseButton1Click:Connect(function()
    if flying then
        status.Text = "✈️ Đang bay..."
        return
    end

    local r = root()
    local list = eggs()

    if #list == 0 then
        status.Text = "❌ Không tìm thấy Egg"
        return
    end

    local best,bestD,bestName

    for _,e in ipairs(list) do
        local p = pos(e)

        if p then
            local d = (r.Position-p).Magnitude

            if not bestD or d > bestD then
                best,bestD,bestName =
                    p,d,e.Name
            end
        end
    end

    if not best then
        status.Text = "❌ Egg không có vị trí"
        return
    end

    saved = r.CFrame

    status.Text = "✈️ Đang bay tới "..bestName

    task.spawn(function()
        fly(
            best + Vector3.new(4,2.5,0),
            best
        )

        if r.Parent then
            status.Text = "✅ Đã tới cạnh "..bestName
        end
    end)
end)

back.MouseButton1Click:Connect(function()
    if not saved then
        status.Text = "❌ Chưa có vị trí cũ"
        return
    end

    if flying then
        flying = false
        task.wait(.05)
    end

    status.Text = "🏠 Đang bay về..."

    task.spawn(function()
        local r = root()
        fly(saved.Position,saved.Position)

        if r.Parent then
            r.CFrame = saved
            status.Text = "🏠 Đã bay về vị trí cũ"
        end
    end)
end)

--==================================================
-- KÉO GUI
--==================================================

local function drag(o)
    local on,start,origin

    o.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then
            on = true
            start = i.Position
            origin = o.Position
        end
    end)

    UIS.InputChanged:Connect(function(i)
        if on and (
            i.UserInputType == Enum.UserInputType.MouseMovement
            or i.UserInputType == Enum.UserInputType.Touch
        ) then
            local d = i.Position-start
            o.Position = UDim2.new(
                origin.X.Scale,origin.X.Offset+d.X,
                origin.Y.Scale,origin.Y.Offset+d.Y
            )
        end
    end)

    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then
            on = false
        end
    end)
end

