    Text.Font = Enum.Font.Gotham
    Text.TextXAlignment = Enum.TextXAlignment.Left
    Text.TextYAlignment = Enum.TextYAlignment.Top
    Text.Parent = Box
end

function AddMessageToUI(Data)
    table.insert(ClientMessages, Data)

    if #ClientMessages > MAX_MESSAGES then
        table.remove(ClientMessages, 1)
        local first
        for _, c in ipairs(List:GetChildren()) do
            if c:IsA("Frame") then first = c break end
        end
        if first then first:Destroy() end
    end

    CreateMessage(Data, tick() * 1000)
    Count.Text = #ClientMessages .. "/" .. MAX_MESSAGES

    task.defer(function()
        List.CanvasPosition = Vector2.new(0, List.AbsoluteCanvasSize.Y)
    end)
end

