local function CreatorBadge(Parent)
    local Badge = Instance.new("TextLabel")
    Badge.Size = UDim2.fromOffset(76, 20)
    Badge.Position = UDim2.new(1, -76, 0, 0)
    Badge.BackgroundTransparency = 1
    Badge.Text = "CREATOR"
    Badge.TextSize = 11
    Badge.Font = Enum.Font.GothamBold
    Badge.Parent = Parent

    task.spawn(function()
        local I = 1
        while Badge.Parent do
            Badge.TextColor3 = Rainbow[I]
            I = I % #Rainbow + 1
            task.wait(.35)
        end
    end)
end

