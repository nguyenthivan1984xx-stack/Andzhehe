--========================================================--
-- JSON HELPERS (không cần HttpService)
--========================================================--

local function Encode(msg)
    -- Escape ký tự đặc biệt
    local function esc(s)
        s = s:gsub("\\", "\\\\")
        s = s:gsub('"', '\\"')
        s = s:gsub("\n", "\\n")
        return s
    end
    return string.format(
        '{"u":"%s","d":"%s","t":"%s"}',
        esc(msg.Username),
        esc(msg.DisplayName),
        esc(msg.Text)
    )
end

local function Decode(str)
    -- Đơn giản hoá: parse thủ công
    local list = {}
    for obj in str:gmatch("{(.-)}") do
        local u = obj:match('"u":"(.-)"')
        local d = obj:match('"d":"(.-)"')
        local t = obj:match('"t":"(.-)"')
        if u and t then
            table.insert(list, {
                Username = u,
                DisplayName = d or u,
                Text = t
            })
        end
    end
    return list
end

--========================================================--
-- SEND MESSAGE (broadcast cho mọi executor)
--========================================================--

local LastSend = 0

local function SendMessage(Text)
    local now = tick()
    if now - LastSend < COOLDOWN then return end
    LastSend = now

    Text = Text:sub(1, MAX_LENGTH)
    if Text:gsub("%s", "") == "" then return end

    local msg = {
        Username = Player.Name,
        DisplayName = Player.DisplayName,
        Text = Text
    }

    -- Đọc list hiện tại
    local current = Decode(MessagesStore.Value)
    table.insert(current, msg)

    -- Giữ tối đa MAX_MESSAGES
    while #current > MAX_MESSAGES do
        table.remove(current, 1)
    end

    -- Rebuild string
    local parts = {}
    for _, m in ipairs(current) do
        table.insert(parts, Encode(m))
    end
    MessagesStore.Value = "[" .. table.concat(parts, ",") .. "]"

    -- Fire cho tất cả (kể cả chính mình)
    Remote:FireServer("Broadcast", msg) -- gửi lên server Roblox (sẽ bị chặn, nhưng FireAllClients không dùng được)
end

--========================================================--
-- NHẬN MESSAGE TỪ NGƯỜI KHÁC
--========================================================--
-- Vì executor không thể dùng FireAllClients, ta dùng
-- cách: theo dõi sự thay đổi của MessagesStore.Value
--========================================================--

local MyMessages = {}

MessagesStore.Changed:Connect(function()
    local list = Decode(MessagesStore.Value)

    -- Chỉ thêm những message mới
    if #list > #MyMessages then
        for i = #MyMessages + 1, #list do
            local data = list[i]
            if data and not (data.Username == Player.Name and i == #list) then
                -- Không thêm lại message của chính mình
                if data.Username ~= Player.Name then
                    AddMessageToUI(data)
                end
            end
        end
    end

    MyMessages = list
end)

