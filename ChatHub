--========================================================--
-- CREATOR BADGE
--========================================================--

local function CreateCreatorBadge(Parent)

    local Creator = Instance.new("TextLabel")

    Creator.Name = "CreatorBadge"
    Creator.Size = UDim2.new(0,76,0,20)
    Creator.Position = UDim2.new(1,-76,0,0)
    Creator.BackgroundTransparency = 1
    Creator.Text = "CREATOR"
    Creator.TextSize = 11
    Creator.Font = Enum.Font.GothamBold
    Creator.TextXAlignment = Enum.TextXAlignment.Right
    Creator.Parent = Parent

    task.spawn(function()

        local Index = 1

        while Creator.Parent do

            Creator.TextColor3 = RainbowColors[Index]

            Index += 1

            if Index > #RainbowColors then
                Index = 1
            end

            task.wait(0.35)
        end

    end)

    return Creator
end

--========================================================--
-- CREATE MESSAGE
--========================================================--

local function CreateMessage(Data)

    local Box = Instance.new("Frame")

    Box.Name = "Message"
    Box.Size = UDim2.new(1,-4,0,0)
    Box.AutomaticSize = Enum.AutomaticSize.Y
    Box.BackgroundColor3 = Color3.fromRGB(31,31,38)
    Box.BorderSizePixel = 0
    Box.Parent = MessageList

    local BoxCorner = Instance.new("UICorner")
    BoxCorner.CornerRadius = UDim.new(0,8)
    BoxCorner.Parent = Box

    local BoxPadding = Instance.new("UIPadding")
    BoxPadding.PaddingTop = UDim.new(0,7)
    BoxPadding.PaddingBottom = UDim.new(0,7)
    BoxPadding.PaddingLeft = UDim.new(0,8)
    BoxPadding.PaddingRight = UDim.new(0,8)
    BoxPadding.Parent = Box

    -- HEADER

    local Header = Instance.new("Frame")
    Header.Size = UDim2.new(1,0,0,20)
    Header.BackgroundTransparency = 1
    Header.Parent = Box

    local Username = Instance.new("TextLabel")
    Username.Size = UDim2.new(1,-80,1,0)
    Username.BackgroundTransparency = 1
    Username.Text = tostring(Data.DisplayName) .. "  @" .. tostring(Data.Username)
    Username.TextColor3 = Color3.fromRGB(190,150,255)
    Username.TextSize = 12
    Username.Font = Enum.Font.GothamBold
    Username.TextXAlignment = Enum.TextXAlignment.Left
    Username.Parent = Header

    -- CREATOR

    if string.lower(tostring(Data.Username)) ==
       string.lower(CREATOR_USERNAME) then

        CreateCreatorBadge(Header)
    end

    -- MESSAGE

    local Text = Instance.new("TextLabel")

    Text.Size = UDim2.new(1,0,0,0)
    Text.Position = UDim2.new(0,0,0,22)
    Text.AutomaticSize = Enum.AutomaticSize.Y
    Text.BackgroundTransparency = 1
    Text.Text = tostring(Data.Text)
    Text.TextWrapped = true
    Text.TextColor3 = Color3.fromRGB(255,255,255)
    Text.TextSize = 14
    Text.Font = Enum.Font.Gotham
    Text.TextXAlignment = Enum.TextXAlignment.Left
    Text.TextYAlignment = Enum.TextYAlignment.Top
    Text.Parent = Box

    return Box
end

--========================================================--
-- REFRESH
--========================================================--

local function RefreshMessages()

    for _, Child in ipairs(MessageList:GetChildren()) do

        if Child:IsA("Frame") then
            Child:Destroy()
        end

    end

    for _, Data in ipairs(Messages) do
        CreateMessage(Data)
    end

    Count.Text = tostring(#Messages) .. "/" .. tostring(MAX_MESSAGES)

    task.defer(function()

        MessageList.CanvasPosition = Vector2.new(
            0,
            math.max(0,MessageList.AbsoluteCanvasSize.Y)
        )

    end)
end

--========================================================--
-- RECEIVE SERVER MESSAGE
--========================================================--

ChatEvent.OnClientEvent:Connect(function(Data)

    if typeof(Data) ~= "table" then
        return
    end

    if not Data.Username or not Data.Text then
        return
    end

    table.insert(Messages,Data)

    while #Messages > MAX_MESSAGES do
        table.remove(Messages,1)
    end

    RefreshMessages()
end)

