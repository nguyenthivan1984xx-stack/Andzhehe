-- ESP SETUP
local function ToggleESP(player, create)
    if player == LP then return end
    if create and not ESPObjects[player] then
        local t, l, b, h = Drawing.new("Text"), Drawing.new("Line"), Drawing.new("Square"), Drawing.new("Line")
        t.Size, t.Center, t.Outline, t.Color = 13, true, true, Color3.fromRGB(255,0,0)
        l.Thickness, l.Color = 1, Color3.fromRGB(190,80,255)
        b.Thickness, b.Color = 2, Color3.fromRGB(255,255,255)
        h.Thickness, h.Color = 4, Color3.fromRGB(0,255,0)
        ESPObjects[player] = {Text = t, Line = l, Box = b, Health = h}
    elseif not create and ESPObjects[player] then
        for _, v in pairs(ESPObjects[player]) do pcall(function() v:Remove() end) end
        ESPObjects[player] = nil
    end
end

for _, p in pairs(Players:GetPlayers()) do 
    ToggleESP(p, true)
    if HeadViewOn then
        ToggleHeadView(p, true)
        updateHeadView(p)
    end
end

Players.PlayerAdded:Connect(function(p) 
    ToggleESP(p, true)
    if HeadViewOn then
        ToggleHeadView(p, true)
        updateHeadView(p)
    end
end)

Players.PlayerRemoving:Connect(function(p) 
    ToggleESP(p, false)
    if HeadViewOn then
        ToggleHeadView(p, false)
    end
end)

local function setupCharacterAdded(player)
    if player == LP then return end
    player.CharacterAdded:Connect(function()
        if HeadViewOn then
            updateHeadView(player)
        end
    end)
end

for _, player in pairs(Players:GetPlayers()) do
    if player ~= LP then
        setupCharacterAdded(player)
    end
end

Players.PlayerAdded:Connect(function(player)
    if player ~= LP then
        setupCharacterAdded(player)
    end
end)

--============================================================
-- MAIN LOOP
--============================================================

RunService.RenderStepped:Connect(function(dt)
    Circle.Size = UDim2.fromOffset(FOV_SIZE, FOV_SIZE)

    -- AUTO HEAD - Giới hạn size tối đa 100
    if AutoHeadOn then
        for _, v in pairs(Players:GetPlayers()) do
            if v ~= LP and v.Character and v.Character:FindFirstChild("Head") then
                pcall(function()
                    local head = v.Character.Head
                    local size = math.min(HITBOX_SIZE, MAX_HEAD_SIZE)
                    head.Size = Vector3.new(size, size, size)
                    head.Transparency = 1
                    head.CanCollide = false
                    head.Massless = true
                end)
            end
        end
    end

    -- SPIN
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if SpinOn and root and hum then
        hum.AutoRotate = false
        SpinAngle = SpinAngle + math.rad(SPIN_SPEED) * dt
        root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, SpinAngle, 0)
    elseif hum then
        hum.AutoRotate = true
    end

    -- ESP
    for player, o in pairs(ESPObjects) do
        local pc = player.Character
        local pHum = pc and pc:FindFirstChildOfClass("Humanoid")
        local pRoot = pc and pc:FindFirstChild("HumanoidRootPart")
        local myRoot = char and char:FindFirstChild("HumanoidRootPart")

        if ESPOn and myRoot and pRoot and pHum and pHum.Health > 0 then
            local pos, vis = Camera:WorldToViewportPoint(pRoot.Position)
            if vis and pos.Z > 0 then
                local dist = math.floor((pRoot.Position - myRoot.Position).Magnitude)
                local w, h = (1000 / pos.Z) * 0.7, 1000 / pos.Z
                local hp = math.clamp(pHum.Health / pHum.MaxHealth, 0, 1)

                o.Box.Size, o.Box.Position, o.Box.Visible = Vector2.new(w, h), Vector2.new(pos.X - w/2, pos.Y - h/2), true
                o.Health.From, o.Health.To, o.Health.Visible = Vector2.new(pos.X - w/2 - 6, pos.Y + h/2), Vector2.new(pos.X - w/2 - 6, pos.Y + h/2 - (h * hp)), true
                o.Text.Position, o.Text.Text, o.Text.Visible = Vector2.new(pos.X, pos.Y - h/2 - 18), player.Name.." ["..dist.."m] ["..math.floor(pHum.Health).."HP]", true
                o.Line.From, o.Line.To, o.Line.Visible = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y), Vector2.new(pos.X, pos.Y + h/2), true
            else o.Text.Visible, o.Line.Visible, o.Box.Visible, o.Health.Visible = false, false, false, false end
        else o.Text.Visible, o.Line.Visible, o.Box.Visible, o.Health.Visible = false, false, false, false end
    end
end)

