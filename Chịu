local HeadViewObjects = {}

local function ToggleHeadView(player, create)
    if player == LP then return end
    if create and not HeadViewObjects[player] then
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "HeadViewBillboard"
        billboard.Adornee = player.Character and player.Character:FindFirstChild("Head")
        billboard.Size = UDim2.new(2, 0, 2, 0)
        billboard.StudsOffset = Vector3.new(0, 0, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = player.Character or workspace
        
        local frame = Instance.new("Frame")
        frame.Name = "HeadViewFrame"
        frame.Size = UDim2.new(1, 0, 1, 0)
        frame.BackgroundTransparency = 1
        frame.BorderSizePixel = 3
        frame.BorderColor3 = Color3.fromRGB(255, 0, 0)
        frame.Parent = billboard
        
        local glow = Instance.new("Frame")
        glow.Size = UDim2.new(1.2, 0, 1.2, 0)
        glow.Position = UDim2.new(-0.1, 0, -0.1, 0)
        glow.BackgroundTransparency = 0.7
        glow.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
        glow.BorderSizePixel = 0
        glow.Parent = frame
        Instance.new("UICorner", glow).CornerRadius = UDim.new(1, 0)
        
        Instance.new("UICorner", frame).CornerRadius = UDim.new(1, 0)
        
        HeadViewObjects[player] = {
            Billboard = billboard,
            Frame = frame
        }
    elseif not create and HeadViewObjects[player] then
        if HeadViewObjects[player].Billboard then
            HeadViewObjects[player].Billboard:Destroy()
        end
        HeadViewObjects[player] = nil
    end
end

local function updateHeadView(player)
    local data = HeadViewObjects[player]
    if not data then return end
    
    local char = player.Character
    local head = char and char:FindFirstChild("Head")
    
    if data.Billboard then
        data.Billboard.Adornee = head
        if char and head then
            data.Billboard.Parent = char
            data.Billboard.Size = UDim2.new(2.5, 0, 2.5, 0)
        else
            data.Billboard.Parent = workspace
            data.Billboard.Adornee = nil
        end
    end
end

local function clearAllHeadViews()
    for player, data in pairs(HeadViewObjects) do
        if data.Billboard then
            data.Billboard:Destroy()
        end
    end
    HeadViewObjects = {}
end

