local function toggleGodMode(on)
    local char = LP.Character
    if not char then return end
    
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    
    if on then
        -- Lưu HP hiện tại
        humanoid:SetAttribute("GodMode_OriginalHealth", humanoid.Health)
        
        -- Vô hiệu hóa sát thương
        humanoid:SetAttribute("GodMode_Active", true)
        
        -- Tạo vòng lặp giữ HP
        local conn
        conn = RunService.Heartbeat:Connect(function()
            if not GodModeOn then
                conn:Disconnect()
                return
            end
            if char and char.Parent and humanoid and humanoid.Health > 0 then
                humanoid.Health = math.max(humanoid.Health, 100)
            end
        end)
        
        -- Lưu connection để hủy sau
        char:SetAttribute("GodMode_Connection", conn)
        
        -- Đổi màu tên thành vàng (hiệu ứng)
        local nameDisplay = char:FindFirstChild("NameDisplay")
        if nameDisplay then
            nameDisplay.TextColor3 = Color3.fromRGB(255, 215, 0)
        end
        
        print("[GOD MODE] Bất tử đã được kích hoạt!")
    else
        -- Tắt bất tử
        humanoid:SetAttribute("GodMode_Active", false)
        
        -- Hủy connection
        local conn = char:GetAttribute("GodMode_Connection")
        if conn then
            conn:Disconnect()
            char:SetAttribute("GodMode_Connection", nil)
        end
        
        -- Reset màu tên
        local nameDisplay = char:FindFirstChild("NameDisplay")
        if nameDisplay then
            nameDisplay.TextColor3 = Color3.fromRGB(255, 255, 255)
        end
        
        print("[GOD MODE] Bất tử đã tắt")
    end
end

