local function MakeButton(txt, order)
    local B = Instance.new("TextButton", Container)
    B.Size, B.Text, B.BackgroundColor3, B.TextColor3, B.Font, B.TextSize, B.LayoutOrder = UDim2.new(0.9,0,0,26), txt, Color3.fromRGB(90,0,130), Color3.fromRGB(255,255,255), Enum.Font.Code, 12, order
    Corner(B)
