local function MakeSliderUI(txtDef, minV, maxV, initV, order, callback)
    local frame = Instance.new("Frame", Container)
    frame.Size, frame.BackgroundTransparency, frame.LayoutOrder = UDim2.new(0.9,0,0,24), 1, order

    local txt = Instance.new("TextLabel", frame)
    txt.Size, txt.Text, txt.BackgroundTransparency, txt.TextColor3, txt.Font, txt.TextSize = UDim2.new(1,0,0,12), txtDef..initV, 1, Color3.fromRGB(220,180,255), Enum.Font.Code, 11

    local back = Instance.new("Frame", frame)
    back.Size, back.Position, back.BackgroundColor3 = UDim2.new(1,0,0,5), UDim2.new(0,0,0,15), Color3.fromRGB(60,40,70)
    Corner(back, 3)

    local bar = Instance.new("Frame", back)
    bar.Size, bar.BackgroundColor3 = UDim2.new((initV-minV)/(maxV-minV),0,1,0), Color3.fromRGB(190,80,255)
    Corner(bar, 3)

    local function update(inputX)
        local pct = math.clamp((inputX - back.AbsolutePosition.X) / back.AbsoluteSize.X, 0, 1)
        local val = math.floor(minV + (maxV - minV) * pct)
        bar.Size = UDim2.new(pct,0,1,0)
        txt.Text = txtDef..val
        callback(val)
    end

    back.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            Dragging = update
            update(input.Position.X)
        end
    end)
end

