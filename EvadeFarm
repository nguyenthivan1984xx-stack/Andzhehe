--==================================================
-- COLLECT ITEMS
--==================================================

local function collectLoop()
    task.spawn(function()
        while collectingItems do
            task.wait(0.25)

            pcall(function()
                local root = getCharacterRoot()
                local effects = workspace:FindFirstChild("Effects")
                local tickets = effects and effects:FindFirstChild("Tickets")

                if not root or not tickets then
                    return
                end

                local ticketList = tickets:GetChildren()
                local ticket = ticketList[1]

                if ticket then
                    local ticketRoot = ticket:FindFirstChild("HumanoidRootPart")
                        or ticket.PrimaryPart

                    if ticketRoot then
                        root.CFrame = CFrame.new(ticketRoot.Position)
                    end
                end
            end)
        end
    end)
end

--==================================================
-- AVOID NEXTBOT
--==================================================

local function findNearestNextbot(root)
    local characterFolder = workspace:FindFirstChild("Players")
    if not characterFolder then
        return nil, math.huge
    end

    local nearest
    local nearestDistance = 30

    for _, model in ipairs(characterFolder:GetChildren()) do
        if model:GetAttribute("AI") == true then
            local botRoot = model:FindFirstChild("HumanoidRootPart")
            if botRoot then
                local distance = (root.Position - botRoot.Position).Magnitude
                if distance < nearestDistance then
                    nearest = model
                    nearestDistance = distance
                end
            end
        end
    end

    return nearest, nearestDistance
end

local function getRandomItemSpawn()
    local map = workspace:FindFirstChild("Map")
    local spawns = map and map:FindFirstChild("ItemSpawns")
    if not spawns then
        return nil
    end

    local choices = {}

    for _, item in ipairs(spawns:GetChildren()) do
        if item.Name == "ItemSpawn" and item:IsA("BasePart") then
            table.insert(choices, item)
        end
    end

    if #choices == 0 then
        return nil
    end

    return choices[math.random(1, #choices)]
end

local function avoidLoop()
    task.spawn(function()
        while avoidingNextbot do
            task.wait(0.2)

            pcall(function()
                local root = getCharacterRoot()
                if not root then
                    return
                end

                local nextbot = findNearestNextbot(root)
                if nextbot then
                    local spawnPoint = getRandomItemSpawn()
                    if spawnPoint then
                        root.CFrame = spawnPoint.CFrame + Vector3.new(0, 3, 0)
                    end
                end
            end)
        end
    end)
end

