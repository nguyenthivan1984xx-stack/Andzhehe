local function createToggle(labelText, yPosition, onChanged)
    local button = create("TextButton", {
        Name = labelText:gsub("%W", "") .. "Toggle",
        Position = UDim2.fromOffset(12, yPosition),
        Size = UDim2.new(1, -24, 0, 43),
        BackgroundColor3 = PANEL,
        Text = "",
        AutoButtonColor = false
    }, Main)

    create("UICorner", {CornerRadius = UDim.new(0, 9)}, button)

    local outline = create("UIStroke", {
        Color = Color3.fromRGB(65, 53, 85),
        Thickness = 1
    }, button)

    create("TextLabel", {
        Position = UDim2.fromOffset(12, 0),
        Size = UDim2.new(1, -65, 1, 0),
        BackgroundTransparency = 1,
        Text = labelText,
        TextColor3 = WHITE,
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left
    }, button)

    local track = create("Frame", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.fromOffset(34, 18),
        BackgroundColor3 = Color3.fromRGB(68, 62, 78),
        BorderSizePixel = 0
    }, button)

    create("UICorner", {CornerRadius = UDim.new(1, 0)}, track)

    local knob = create("Frame", {
        Position = UDim2.fromOffset(2, 2),
        Size = UDim2.fromOffset(14, 14),
        BackgroundColor3 = WHITE,
        BorderSizePixel = 0
    }, track)

    create("UICorner", {CornerRadius = UDim.new(1, 0)}, knob)

    local enabled = false

    local function setEnabled(state)
        enabled = state

        tween(track, 0.16, {
            BackgroundColor3 = enabled and PURPLE or Color3.fromRGB(68, 62, 78)
        })

        tween(knob, 0.16, {
            Position = enabled and UDim2.fromOffset(18, 2) or UDim2.fromOffset(2, 2)
        })

        tween(outline, 0.16, {
            Color = enabled and PURPLE or Color3.fromRGB(65, 53, 85)
        })

        return enabled
    end

    button.Activated:Connect(function()
        local newState = setEnabled(not enabled)
        if onChanged then
            onChanged(newState)
        end
    end)

    return button, setEnabled, function()
        return enabled
    end
end

