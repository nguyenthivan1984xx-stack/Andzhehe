local function Button(text,y)

	local b = Instance.new("TextButton")

	b.Size = UDim2.fromOffset(240,38)
	b.Position = UDim2.new(0,20,0,y)

	b.BackgroundColor3 =
		Color3.fromRGB(60,30,85)

	b.TextColor3 =
		Color3.new(1,1,1)

	b.TextSize = 15
	b.Font = Enum.Font.GothamSemibold
	b.Text = text

	b.AutoButtonColor = false
	b.Parent = Main

	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0,8)
	c.Parent = b

	return b
end

local function ToggleText(button,name,state)

	button.Text =
		name..": "..(state and "ON" or "OFF")

	button.BackgroundColor3 =
		state
		and Color3.fromRGB(105,45,150)
		or Color3.fromRGB(60,30,85)
end

