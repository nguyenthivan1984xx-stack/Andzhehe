local savedPosition = nil

--==================================================
-- BAY TỚI CẠNH EGG
--==================================================

local flyingToEgg = false

local function flyBesideEgg(root,eggPosition)

if flyingToEgg then
return false
end

flyingToEgg = true

local distance = 4

local targetPosition =
eggPosition + Vector3.new(distance,2.5,0)

local startPosition = root.Position

-- TỐC ĐỘ 1 = 10 GIÂY
-- TỐC ĐỘ 10 = 1 GIÂY
local duration = 10 / flySpeed

local startTime = tick()

while flyingToEgg and root.Parent do

local elapsed =    
    tick() - startTime    

local alpha =    
    math.clamp(    
        elapsed / duration,    
        0,    
        1    
    )    

local smoothAlpha =    
    alpha * alpha * (3 - 2 * alpha)    

local currentPosition =    
    startPosition:Lerp(    
        targetPosition,    
        smoothAlpha    
    )    

root.CFrame =    
    CFrame.lookAt(    
        currentPosition,    
        eggPosition    
    )    

root.AssemblyLinearVelocity =    
    Vector3.zero    

root.AssemblyAngularVelocity =    
    Vector3.zero    

if alpha >= 1 then    
    break    
end    

task.wait(0.03)

end

if root.Parent and flyingToEgg then

root.CFrame =    
    CFrame.lookAt(    
        targetPosition,    
        eggPosition    
    )    

root.AssemblyLinearVelocity =    
    Vector3.zero    

root.AssemblyAngularVelocity =    
    Vector3.zero

end

flyingToEgg = false

return true

end

--==================================================
-- BAY TỚI EGG XA NHẤT
--==================================================

tele.MouseButton1Click:Connect(function()

if flyingToEgg then

status.Text =    
    "✈️ Đang bay tới Egg..."    

return

end

local root = getRoot()
local eggs = findEggs()

if #eggs == 0 then

status.Text =    
    "❌ Không tìm thấy Egg"    

return

end

local farthestPosition = nil
local farthestName = nil
local farthestDistance = -math.huge

for _,egg in ipairs(eggs) do

local pos = getPosition(egg)    

if pos then    

    local distance =    
        (root.Position - pos).Magnitude    

    if distance > farthestDistance then    

        farthestDistance = distance    
        farthestPosition = pos    
        farthestName = egg.Name    

    end    
end

end

if not farthestPosition then

status.Text =    
    "❌ Egg không có vị trí"    

return

end

savedPosition = root.CFrame

status.Text =
"✈️ Đang bay tới " ..
farthestName ..
"..."

task.spawn(function()

local success =    
    flyBesideEgg(    
        root,    
        farthestPosition    
    )    

if success and root.Parent then    

    status.Text =    
        "✅ Đã tới cạnh " ..    
        farthestName ..    
        " | " ..    
        math.floor(farthestDistance) ..    
        " studs"    
end

end)

end)

