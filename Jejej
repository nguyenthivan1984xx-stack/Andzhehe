--==================================================
-- FUNCTIONS
--==================================================

local function root()
    return (pl.Character or pl.CharacterAdded:Wait()):WaitForChild("HumanoidRootPart")
end

local function pos(o)
    if o:IsA("BasePart") then return o.Position end
    if o:IsA("Model") then
        local ok,cf=pcall(function() return o:GetPivot() end)
        if ok then return cf.Position end
    end
end

local function container(o)
    for _=1,12 do
        if not o then break end
        if o:IsA("Model") then return o end
        o=o.Parent
    end
end

local function eggs()
    local t,c={},{}
    for _,o in ipairs(workspace:GetDescendants()) do
        local n=o.Name:lower()
        local found=string.find(n,"egg",1,true)

        if o:IsA("TextLabel") or o:IsA("TextButton") then
            found=found or string.find(tostring(o.Text):lower(),"egg",1,true)
        end

        if o:IsA("ProximityPrompt") then
            found=found or o.ActionText:lower()=="steal"
            found=found or string.find(o.ObjectText:lower(),"egg",1,true)
        end

        if found then
            local m=container(o)
            if m and not c[m] then
                c[m]=true
                table.insert(t,m)
            end
        end
    end
    return t
end

--==================================================
-- RUN
--==================================================

local saved
local running=false

local function runTo(r,target)
    local h=r.Parent:FindFirstChildOfClass("Humanoid")
    if not h then return false end

    running=true
    h.WalkSpeed=speed
    h:MoveTo(target)

    while running and h.Health>0 and r.Parent do
        if (Vector3.new(r.Position.X,0,r.Position.Z)
        -Vector3.new(target.X,0,target.Z)).Magnitude<=5 then
            break
        end
        h:MoveTo(target)
        task.wait(.1)
    end

    h:MoveTo(r.Position)
    running=false
    return true
end

tele.MouseButton1Click:Connect(function()

    if running then
        status.Text="🏃 Đang chạy..."
        return
    end

    local r=root()
    local list=eggs()

    if #list==0 then
        status.Text="❌ Không tìm thấy Egg"
        return
    end

    local target,name,dist=nil,nil,-math.huge

    for _,e in ipairs(list) do
        local p=pos(e)
        if p then
            local d=(r.Position-p).Magnitude
            if d>dist then
                dist=d
                target=p
                name=e.Name
            end
        end
    end

    if not target then
        status.Text="❌ Egg không có vị trí"
        return
    end

    saved=r.CFrame
    status.Text="🏃 Đang chạy tới "..name.."..."

    local dir=(r.Position-target)
    dir=Vector3.new(dir.X,0,dir.Z)

    if dir.Magnitude<.1 then
        dir=Vector3.new(1,0,0)
    else
        dir=dir.Unit
    end

    target=target+dir*4
    target=Vector3.new(target.X,r.Position.Y,target.Z)

    task.spawn(function()
        if runTo(r,target) then
            status.Text="✅ Đã tới cạnh "..name
        end
    end)
end)

