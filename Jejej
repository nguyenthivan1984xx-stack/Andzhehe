--==================================================

local function getPosition(obj)

if obj:IsA("BasePart") then
return obj.Position
end

if obj:IsA("Model") then

local success,cf = pcall(function()    
    return obj:GetPivot()    
end)    

if success then    
    return cf.Position    
end

end

return nil

end

--==================================================
-- EGG CONTAINER
--==================================================

local function findEggContainer(obj)

local current = obj

for _ = 1,12 do

if not current then    
    break    
end    

if current:IsA("Model") then    
    return current    
end    

current = current.Parent

end

return nil

end

--==================================================
-- TÌM EGG
--==================================================

local function findEggs()

local eggs = {}
local checked = {}

for _,obj in ipairs(workspace:GetDescendants()) do

local name = obj.Name:lower()    

if string.find(name,"egg",1,true) then    

    local model = findEggContainer(obj)    

    if model and not checked[model] then    
        checked[model] = true    
        table.insert(eggs,model)    
    end    
end    

if obj:IsA("TextLabel")    
    or obj:IsA("TextButton") then    

    local text = tostring(obj.Text):lower()    

    if string.find(text,"egg",1,true) then    

        local model = findEggContainer(obj)    

        if model and not checked[model] then    
            checked[model] = true    
            table.insert(eggs,model)    
        end    
    end    
end    

if obj:IsA("ProximityPrompt") then    

    local action =    
        tostring(obj.ActionText):lower()    

    local objectText =    
        tostring(obj.ObjectText):lower()    

    if action == "steal"    
        or string.find(objectText,"egg",1,true) then    

        local model = findEggContainer(obj)    

        if model and not checked[model] then    
            checked[model] = true    
            table.insert(eggs,model)    
        end    
    end    
end

end

return eggs

end

