-- BAY VỀ VỊ TRÍ CŨ
--==================================================

back.MouseButton1Click:Connect(function()
if not savedPosition then
status.Text="❌ Chưa có vị trí cũ"
return
end

if flyingToEgg then  
    flyingToEgg=false  
    task.wait()  
end  

local root=getRoot()  
local start,target=root.Position,savedPosition.Position  
local t=tick()  

flyingToEgg=true  

while flyingToEgg and root.Parent do  
    local a=math.clamp((tick()-t)/(10/flySpeed),0,1)  
    a=a*a*(3-2*a)  

    root.CFrame=CFrame.lookAt(  
        start:Lerp(target,a),  
        target  
    )  

    root.AssemblyLinearVelocity=Vector3.zero  
    root.AssemblyAngularVelocity=Vector3.zero  

    if a>=1 then break end  
    task.wait(.03)  
end  

flyingToEgg=false  
status.Text="📍 Đã bay về vị trí cũ"

end)

