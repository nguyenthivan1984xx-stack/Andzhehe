--==================================================
-- KIỂM TRA KEY
--==================================================

local function checkKey()
if keyBox.Text == KEY then
keyFrame.Visible = false
main.Visible = true
else
keyBox.Text = ""
keyBox.PlaceholderText = "❌ Key không đúng!"
end
end

enterButton.Activated:Connect(checkKey)

keyBox.FocusLost:Connect(function(enterPressed)
if enterPressed then
checkKey()
end
end)
