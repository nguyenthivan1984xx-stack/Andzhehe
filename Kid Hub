local function makeButton(text, y)
local b = Instance.new("TextButton")
b.Size = UDim2.new(1, -20, 0, 42)
b.Position = UDim2.fromOffset(10, y)
b.BackgroundColor3 = Color3.fromRGB(55, 55, 65)
b.TextColor3 = Color3.new(1, 1, 1)
b.Text = text
b.TextSize = 15
b.Font = Enum.Font.Gotham
b.Parent = main

Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)  

return b

end

local moveButton = makeButton("🚀 Dịch chuyển +10", 50)
local saveButton = makeButton("📍 Lưu vị trí", 98)
local returnButton = makeButton("🔙 Teleport về vị trí", 146)
local closeButton = makeButton("🔽 Đóng menu", 194)

--==================================================
-- DỊCH CHUYỂN MỘT ĐOẠN
--==================================================

moveButton.Activated:Connect(function()
local character = player.Character
local root = character and character:FindFirstChild("HumanoidRootPart")

if root then  
	root.CFrame = root.CFrame + root.CFrame.LookVector * 10  
end

end)

--==================================================
-- LƯU VỊ TRÍ
--==================================================

saveButton.Activated:Connect(function()
local character = player.Character
local root = character and character:FindFirstChild("HumanoidRootPart")

if root then  
	savedPosition = root.CFrame  
	saveButton.Text = "✓ Đã lưu vị trí"  

	task.delay(1.5, function()  
		if saveButton then  
			saveButton.Text = "📍 Lưu vị trí"  
		end  
	end)  
end

end)

--==================================================
-- TELEPORT VỀ VỊ TRÍ ĐÃ LƯU
--==================================================

returnButton.Activated:Connect(function()
local character = player.Character
local root = character and character:FindFirstChild("HumanoidRootPart")

if root and savedPosition then  
	root.CFrame = savedPosition  
end

end)

