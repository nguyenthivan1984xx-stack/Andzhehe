local draggingHeight = false

local function UpdateHeight(x)

    local alpha = math.clamp(
        (x - HeightSlider.AbsolutePosition.X)
        / HeightSlider.AbsoluteSize.X,
        0,
        1
    )

    EmitterHeight = -3 + alpha * 4

    HeightFill.Size = UDim2.new(alpha,0,1,0)

    HeightLabel.Text =
        "HEIGHT: "
        ..string.format("%.1f",EmitterHeight)

end

HeightSlider.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        draggingHeight = true
        UpdateHeight(input.Position.X)

    end

end)

UserInputService.InputChanged:Connect(function(input)

    if not draggingHeight then return end

    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then

        UpdateHeight(input.Position.X)

    end

end)

UserInputService.InputEnded:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        draggingHeight = false

    end

end)

