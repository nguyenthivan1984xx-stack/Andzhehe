--========================================================--
-- POSITION
--========================================================--

RunService.RenderStepped:Connect(function()

    local Character = Player.Character
    if not Character then return end

    local Root = Character:FindFirstChild("HumanoidRootPart")
    if not Root then return end

    if not Box or not Box.Parent
        or not PinkCube or not PinkCube.Parent then

        CreateEmitter()

    end

    Box.Size =
        Vector3.new(
            BoxWidth,
            BoxHeight,
            BoxLength
        )

    local CF =
        Root.CFrame *
        CFrame.new(
            0,
            EmitterHeight,
            EmitterForward
        )

    if JerkEnabled then

        CF =
            CF *
            CFrame.new(
                math.sin(tick()*25)*.08,
                math.sin(tick()*31)*.05,
                0
            )

    end

    Box.CFrame = CF

    PinkCube.CFrame =
        CF *
        CFrame.new(
            0,
            0,
            -(BoxLength/2+.35)
        )

end)

--========================================================--
-- PARTICLE
--========================================================--

local function ShootParticle()

    if not Enabled then return end
    if not PinkCube or not PinkCube.Parent then return end

    local Start =
        PinkCube.Position +
        PinkCube.CFrame.LookVector*.4

    local Particle = Instance.new("Part")

    Particle.Name = "VisualParticle"
    Particle.Shape = Enum.PartType.Ball

    Particle.Size =
        Vector3.new(
            ParticleSize,
            ParticleSize,
            ParticleSize
        )

    Particle.Material = Enum.Material.Neon
    Particle.Color = ParticleColor

    Particle.Anchored = true
    Particle.CanCollide = false
    Particle.CanTouch = false
    Particle.CanQuery = false
    Particle.CastShadow = false
    Particle.Position = Start
    Particle.Parent = workspace

    local Direction =
        PinkCube.CFrame.LookVector *
        ParticleSpeed +
        Vector3.new(0,3,0)

    local Gravity = Vector3.new(0,-45,0)

    local Started = tick()
    local Last = Start

    local Params = RaycastParams.new()

    Params.FilterType =
        Enum.RaycastFilterType.Exclude

    Params.FilterDescendantsInstances = {
        Player.Character,
        Particle,
        Folder
    }

    local Connection

    Connection =
        RunService.Heartbeat:Connect(function()

            if not Particle.Parent then
                Connection:Disconnect()
                return
            end

            local Time = tick()-Started

            local Position =
                Start +
                Direction*Time +
                .5*Gravity*Time*Time

            local Hit =
                workspace:Raycast(
                    Last,
                    Position-Last,
                    Params
                )

            if Hit then

                Particle.Position =
                    Hit.Position +
                    Hit.Normal*(ParticleSize/2)

                Connection:Disconnect()

                task.delay(
                    GroundLifetime,
                    function()

                        if Particle.Parent then
                            Particle:Destroy()
                        end

                    end
                )

                return
            end

            Particle.Position = Position
            Last = Position

            if Time >= 30 then

                Connection:Disconnect()

                if Particle.Parent then
                    Particle:Destroy()
                end

            end

        end)

end

