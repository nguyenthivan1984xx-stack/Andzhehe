local Fixed = false

local function IsProtected(object)
    local current = object

    while current and current ~= Workspace do
        local name = current.Name:lower()

        if name:find("egg",1,true)
        or name:find("guard",1,true)
        or name:find("pet",1,true) then
            return true
        end

        if current:IsA("Model")
        and current:FindFirstChildOfClass("Humanoid") then
            return true
        end

        current = current.Parent
    end

    return false
end

Connect(Fix.MouseButton1Click,function()
    if Fixed then return end

    Fixed = true
    Fix.Text = "Fix Lag: ON"

    pcall(function()
        Lighting.GlobalShadows = false
    end)

    for _,object in ipairs(Lighting:GetDescendants()) do
        if object:IsA("PostEffect") then
            pcall(function()
                object.Enabled = false
            end)
        end
    end

    for _,object in ipairs(Workspace:GetDescendants()) do
        if not IsProtected(object) then
            pcall(function()
                if object:IsA("BasePart") then
                    object.CastShadow = false

                elseif object:IsA("ParticleEmitter")
                or object:IsA("Trail")
                or object:IsA("Beam")
                or object:IsA("Smoke")
                or object:IsA("Fire")
                or object:IsA("Sparkles") then
                    object.Enabled = false
                end
            end)
        end
    end
end)

