local function IsCreatorText(text)
    if not CreatorPlayer or not text then
        return false
    end

    local username = CreatorPlayer.Name
    local displayName = CreatorPlayer.DisplayName

    return text:find("@" .. username,1,true) ~= nil
        or text:find(username,1,true) ~= nil
        or text:find(displayName,1,true) ~= nil
end

