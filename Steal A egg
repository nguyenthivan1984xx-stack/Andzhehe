local function Load(url,button,originalText)
    if button:GetAttribute("Loading") then
        return
    end

    button:SetAttribute("Loading",true)
    button.Text = "Loading..."

    task.spawn(function()
        local success,err = pcall(function()
            local code = game:HttpGet(url)
            local fn = loadstring(code)

            if not fn then
                error("Không thể biên dịch script")
            end

            fn()
        end)

        if not success then
            warn("[ICUS HUB]",err)
            button.Text = "Load Failed"
            task.wait(1)
        end

        if button.Parent then
            button.Text = originalText
            button:SetAttribute("Loading",false)
        end
    end)
end

