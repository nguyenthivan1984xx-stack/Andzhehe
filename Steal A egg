local function RefreshPlayerList()
    for _,child in ipairs(PlayerScroll:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end

    local allPlayers = Players:GetPlayers()

    table.sort(allPlayers,function(a,b)
        if IsCreator(a) ~= IsCreator(b) then
            return IsCreator(a)
        end

        return a.Name:lower() < b.Name:lower()
    end)

    for index,player in ipairs(allPlayers) do
        local row = Instance.new("Frame")
        row.Name = "Player_" .. player.UserId
        row.Size = UDim2.new(1,-8,0,34)
        row.BackgroundColor3 = ButtonColor
        row.BorderSizePixel = 0
        row.LayoutOrder = index
        row.Parent = PlayerScroll

        Corner(row,7)

        local Name = Instance.new("TextLabel")
        Name.Size = UDim2.new(1,-12,1,0)
        Name.Position = UDim2.fromOffset(6,0)
        Name.BackgroundTransparency = 1
        Name.TextXAlignment = Enum.TextXAlignment.Left
        Name.Font = Enum.Font.GothamBold
        Name.TextSize = 13
        Name.TextTruncate = Enum.TextTruncate.AtEnd
        Name.Parent = row

        if IsCreator(player) then
            -- Huy hiệu mô phỏng, chỉ trong UI tùy chỉnh.
            Name.Text = "@" .. player.Name .. "  ✓ ⭐"
            Name.TextColor3 = Color3.fromRGB(180,155,255)

            Stroke(row,Purple,1)
        else
            Name.Text = "@" .. player.Name
            Name.TextColor3 = White
        end
    end
end

