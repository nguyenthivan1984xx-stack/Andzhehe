local function RunScript(URL)

    task.spawn(function()

        local Success, Result = pcall(function()

            local Source = game:HttpGet(URL)
            local Func = loadstring(Source)

            if not Func then
                error("Không thể load script.")
            end

            return Func()
        end)

        if not Success then
            warn("[Best Hub] Script error:", Result)
        end

    end)
end

