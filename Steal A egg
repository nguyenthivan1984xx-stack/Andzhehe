--========================================================--
-- SCRIPT LOADER
--========================================================--

local function RunScript(url)
    task.spawn(function()

        local success, result = pcall(function()
            local source = game:HttpGet(url)
            local func = loadstring(source)

            if not func then
                error("Không thể load script.")
            end

            return func()
        end)

        if not success then
            warn("[BEST HUB] Lỗi script:", result)
        end

    end)
end

