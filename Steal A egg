local FixLagEnabled = false

-- Lưu những Animator của Guard đã kết nối
local GuardAnimators = {}

--========================================================--
-- KIỂM TRA OBJECT ĐƯỢC BẢO VỆ
--========================================================--

local function IsProtected(Object)

    local Current = Object

    while Current and Current ~= Workspace do

        local Name = string.lower(Current.Name)

        if string.find(Name, "egg", 1, true)
        or string.find(Name, "guard", 1, true) then

            return true
        end

        Current = Current.Parent
    end

    return false
end

--========================================================--
-- KIỂM TRA NHÂN VẬT
--========================================================--

local function IsCharacter(Object)

    local Model = Object:FindFirstAncestorOfClass("Model")

    if Model and Model:FindFirstChildOfClass("Humanoid") then
        return true
    end

    return false
end

--========================================================--
-- KIỂM TRA GUARD
--========================================================--

local function GetGuardModel(Object)

    local Current = Object

    while Current and Current ~= Workspace do

        if Current:IsA("Model") then

            local Name = string.lower(Current.Name)

            if string.find(Name, "guard", 1, true) then
                return Current
            end
        end

        Current = Current.Parent
    end

    return nil
end

--========================================================--
-- TẮT ANIMATION GUARD
--========================================================--

local function StopGuardAnimations(GuardModel)

    if not GuardModel then
        return
    end

    -- Không xử lý character
    if GuardModel:FindFirstChildOfClass("Player") then
        return
    end

    local Humanoid = GuardModel:FindFirstChildOfClass("Humanoid")

    if not Humanoid then
        return
    end

    local Animator = Humanoid:FindFirstChildOfClass("Animator")

    if not Animator then
        return
    end

    -- Dừng animation đang chạy
    pcall(function()

        for _, Track in ipairs(
            Animator:GetPlayingAnimationTracks()
        ) do

            Track:Stop(0)
        end

    end)

    -- Chỉ kết nối một lần
    if GuardAnimators[Animator] then
        return
    end

    GuardAnimators[Animator] = true

    -- Nếu Guard phát animation mới thì dừng ngay
    Animator.AnimationPlayed:Connect(function(Track)

        if not FixLagEnabled then
            return
        end

        pcall(function()
            Track:Stop(0)
        end)

    end)
end

--========================================================--
-- PROCESS OBJECT
--========================================================--

local function ProcessObject(Object)

    if not Object or not Object.Parent then
        return
    end

    --====================================================--
    -- GUARD
    --====================================================--

    local GuardModel = GetGuardModel(Object)

    if GuardModel then

        -- Không xóa Guard
        -- Chỉ dừng animation
        StopGuardAnimations(GuardModel)

        return
    end

    --====================================================--
    -- KHÔNG XỬ LÝ NHÂN VẬT
    --====================================================--

    if IsCharacter(Object) then
        return
    end

    --====================================================--
    -- GIỮ EGG
    --====================================================--

    if IsProtected(Object) then
        return
    end

    --====================================================--
    -- BASEPART
    --====================================================--

    if Object:IsA("BasePart") then

        -- Ẩn vật thể có thể đi xuyên qua
        if Object.CanCollide == false then

            pcall(function()

                Object.LocalTransparencyModifier = 1
                Object.CanQuery = false
                Object.CanTouch = false

            end)
        end

        -- Xóa màu vật thể MAP
        pcall(function()

            Object.Color = Color3.fromRGB(
                255,
                255,
                255
            )

        end)

        -- Tắt bóng
        pcall(function()
            Object.CastShadow = false
        end)
    end

    --====================================================--
    -- SPECIAL MESH
    --====================================================--

    if Object:IsA("SpecialMesh") then

        pcall(function()

            Object.VertexColor = Vector3.new(
                1,
                1,
                1
            )

        end)
    end

    --====================================================--
    -- EFFECTS
    --====================================================--

    if Object:IsA("ParticleEmitter")
    or Object:IsA("Trail")
    or Object:IsA("Beam")
    or Object:IsA("Smoke")
    or Object:IsA("Fire")
    or Object:IsA("Sparkles") then

        pcall(function()
            Object.Enabled = false
        end)

    end
end

--========================================================--
-- CHẠY FIX LAG
--========================================================--

local function RunFixLag()

    if FixLagEnabled then
        return
    end

    FixLagEnabled = true

    --====================================================--
    -- XỬ LÝ OBJECT HIỆN TẠI
    --====================================================--

    for _, Object in ipairs(
        Workspace:GetDescendants()
    ) do

        task.defer(function()
            ProcessObject(Object)
        end)

    end

    --====================================================--
    -- XỬ LÝ OBJECT MỚI
    --====================================================--

    Workspace.DescendantAdded:Connect(function(Object)

        if not FixLagEnabled then
            return
        end

        task.defer(function()
            ProcessObject(Object)
        end)

    end)

    --====================================================--
    -- TẮT GLOBAL SHADOW
    --====================================================--

    pcall(function()
        Lighting.GlobalShadows = false
    end)

    --====================================================--
    -- TẮT LIGHTING EFFECTS
    --====================================================--

    for _, Object in ipairs(
        Lighting:GetChildren()
    ) do

        if Object:IsA("BloomEffect")
        or Object:IsA("BlurEffect")
        or Object:IsA("ColorCorrectionEffect")
        or Object:IsA("SunRaysEffect")
        or Object:IsA("DepthOfFieldEffect") then

            pcall(function()
                Object.Enabled = false
            end)

        end
    end

    FixLagButton.Text = "Fix Lag: ON"

    print("================================")
    print("       BEST HUB FIX LAG")
    print("================================")
    print("✓ Non-collidable blocks hidden")
    print("✓ Egg protected")
    print("✓ Guards protected")
    print("✓ Guard animations stopped")
    print("✓ Characters protected")
    print("✓ Map colors removed")
    print("✓ Shadows disabled")
    print("✓ Effects disabled")
    print("================================")

end

FixLagButton.MouseButton1Click:Connect(function()

    RunFixLag()

end)

