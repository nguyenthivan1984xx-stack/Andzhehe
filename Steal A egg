local function IsPlayerListObject(object)
    local parent = object

    while parent and parent ~= CoreGui do
        local lower = parent.Name:lower()

        if lower:find("playerlist")
        or lower:find("player_list")
        or lower:find("people") then
            return true
        end

        parent = parent.Parent
    end

    return false
end

local function RemoveBadge(object)
    local badge = BadgeCache[object]

    if badge then
        pcall(function()
            badge:Destroy()
        end)

        BadgeCache[object] = nil
    end
end

local function UpdateBadge(object)
    if not Alive or not object.Parent then
        return
    end

    if not CreatorPlayer
    or not StarCreatorImage
    or not IsPlayerListObject(object)
    or not IsCreatorText(object.Text) then

        RemoveBadge(object)
        return
    end

    if BadgeCache[object] then
        return
    end

    local parent = object.Parent

    local badge = Instance.new("ImageLabel")
    badge.Name = "ICUS_StarCreatorBadge"
    badge.BackgroundTransparency = 1
    badge.Image = StarCreatorImage
    badge.Size = UDim2.fromOffset(14,14)
    badge.AnchorPoint = Vector2.new(1,0.5)
    badge.Position = UDim2.new(0,-3,0.5,1)
    badge.ZIndex = object.ZIndex + 1
    badge.Parent = parent

    BadgeCache[object] = badge
end

local function WatchText(object)
    if not (
        object:IsA("TextLabel")
        or object:IsA("TextButton")
    ) then
        return
    end

    if BadgeConnections[object] then
        return
    end

    if not IsPlayerListObject(object) then
        return
    end

    BadgeConnections[object] =
        Connect(object:GetPropertyChangedSignal("Text"),function()
            UpdateBadge(object)
        end)

    UpdateBadge(object)
end

-- Quét danh sách người chơi hiện có
local function ScanPlayerList()
    for _,object in ipairs(CoreGui:GetDescendants()) do
        WatchText(object)
