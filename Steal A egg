local function Load(url,button,originalText)
    if button:GetAttribute("Loading") then return end

    button:SetAttribute("Loading",true)
    button.Text = "Loading..."

    task.spawn(function()
        local ok,err = pcall(function()
            local code = game:HttpGet(url)
            local fn = loadstring(code)
            assert(fn,"Khong the bien dich script")
            fn()
        end)

        if not ok then
            warn("[ICUS HUB] Load error:",err)
            if button.Parent then button.Text = "Load Failed" end
            task.wait(1)
        end

        if button.Parent then
            button.Text = originalText
            button:SetAttribute("Loading",false)
        end
    end)
end

