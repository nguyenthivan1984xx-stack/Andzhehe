-- Chỉ tạo hiệu ứng ở phía client đang chạy.
-- Không thay đổi trạng thái Verified chính thức.

local PreviousChatCallback = TextChatService.OnIncomingMessage

pcall(function()
    TextChatService.OnIncomingMessage = function(message)
        local properties

        if PreviousChatCallback then
            local success,result = pcall(
                PreviousChatCallback,
                message
            )

            if success then
                properties = result
            end
        end

        properties = properties
            or Instance.new("TextChatMessageProperties")

        if CreatorPlayer
        and message.TextSource
        and message.TextSource.UserId == CreatorPlayer.UserId then

            local prefix = properties.PrefixText

            if not prefix or prefix == "" then
                prefix = message.PrefixText
            end

            if prefix and not prefix:find(VerifiedSymbol,1,true) then
                properties.PrefixText =
                    prefix .. VerifiedSymbol
            end
        end

        return properties
    end
end)

