--========================================================--
-- FIX LAG
--========================================================--

local FixLagEnabled = false
local GuardAnimators = {}

-- Kiểm tra vật thể có phải Egg hoặc Guard không
local function IsProtected(Object)
    local Current = Object

    while Current and Current ~= Workspace do
        local Name = string.lower(Current.Name)

        if string.find(Name, "egg")
        or string.find(Name, "guard") then
            return true
        end

        Current = Current.Parent
    end

    return false
end

-- Kiểm tra có thuộc Character của người chơi/NPC có Humanoid không
local function IsCharacter(Object)
    local Model = Object:FindFirstAncestorOfClass("Model")

    if not Model then
        return false
    end

    return Model:FindFirstChildOfClass("Humanoid") ~= nil
end

-- Tìm Model Guard
local function GetGuardModel(Object)
    local Current = Object

    while Current and Current ~= Workspace do
        if Current:IsA("Model") then
            local Name = string.lower(Current.Name)

            if string.find(Name, "guard") then
                return Current
            end
        end

        Current = Current.Parent
    end

    return nil
end

--========================================================--
-- DỪNG ANIMATION GUARD
--========================================================--

local function StopGuardAnimations(GuardModel)
    if not GuardModel then
        return
    end

    local Humanoid = GuardModel:FindFirstChildOfClass("Humanoid")

    if not Humanoid then
        return
    end

    local Animator = Humanoid:FindFirstChildOfClass("Animator")

    if not Animator then
        return
    end

    -- Dừng animation hiện tại
    for _, Track in ipairs(Animator:GetPlayingAnimationTracks()) do
        pcall(function()
            Track:Stop(0)
        end)
    end

    -- Không tạo connection trùng
    if GuardAnimators[Animator] then
        return
    end

    GuardAnimators[Animator] = true

    -- Animation mới phát cũng bị dừng
    Animator.AnimationPlayed:Connect(function(Track)
        if not FixLagEnabled then
            return
        end

        pcall(function()
            Track:Stop(0)
        end)
    end)
end

--========================================================--
-- XỬ LÝ OBJECT
--========================================================--

local function ProcessObject(Object)

    if not Object or not Object.Parent then
        return
    end

    -- Guard luôn được xử lý trước
    local GuardModel = GetGuardModel(Object)

    if GuardModel then
        StopGuardAnimations(GuardModel)
        return
    end

    -- Không đụng vào Character
    if IsCharacter(Object) then
        return
    end

    -- Giữ Egg
    if IsProtected(Object) then
        return
    end

    -- BasePart
    if Object:IsA("BasePart") then

        -- Chỉ ẩn vật thể có thể đi xuyên qua
        if Object.CanCollide == false then
            Object.LocalTransparencyModifier = 1
            Object.CanQuery = false
            Object.CanTouch = false
        end

        -- Xoá màu
        pcall(function()
            Object.Color = Color3.fromRGB(255, 255, 255)
        end)

        -- Xoá bóng
        Object.CastShadow = false
    end

    -- Mesh
    if Object:IsA("SpecialMesh") then
        pcall(function()
            Object.VertexColor = Vector3.new(1, 1, 1)
        end)
    end

    -- Tắt hiệu ứng
    if Object:IsA("ParticleEmitter")
    or Object:IsA("Trail")
    or Object:IsA("Beam")
    or Object:IsA("Smoke")
    or Object:IsA("Fire")
    or Object:IsA("Sparkles") then

        Object.Enabled = false
    end
end

--========================================================--
-- CHẠY FIX LAG
--========================================================--

local function RunFixLag()

    if FixLagEnabled then
        return
    end

    FixLagEnabled = true

    -- Xử lý Lighting
    pcall(function()
        Lighting.GlobalShadows = false
    end)

    -- Tắt Post Effects
    for _, Effect in ipairs(Lighting:GetDescendants()) do
        if Effect:IsA("PostEffect") then
            pcall(function()
                Effect.Enabled = false
            end)
        end
    end

    -- Xử lý Workspace
    for _, Object in ipairs(Workspace:GetDescendants()) do
        task.defer(function()
            if FixLagEnabled then
                ProcessObject(Object)
            end
        end)
    end

    -- Xử lý object mới xuất hiện
    Workspace.DescendantAdded:Connect(function(Object)
        if not FixLagEnabled then
            return
        end

        task.defer(function()
            if FixLagEnabled then
                ProcessObject(Object)
            end
        end)
    end)

    FixLagButton.Text = "Fix Lag: ON"
end

