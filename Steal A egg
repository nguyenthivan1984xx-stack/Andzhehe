        ~= string.lower(CreatorUsername) then

        return
    end

    if PlayerObject.Character then

        task.spawn(function()

            AddCreatorTag(
                PlayerObject.Character
            )

        end)

    end

    PlayerObject.CharacterAdded:Connect(
        function(Character)

            task.wait(0.5)

            AddCreatorTag(Character)

        end
    )
end

