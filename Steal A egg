local function Load(URL)

    task.spawn(function()

        local Success,Error=pcall(function()

            local Code=game:HttpGet(URL)
            local Function=loadstring(Code)

            if Function then
                Function()
            end

        end)

        if not Success then
            warn("[TỔNG HỢP SCRIPT NOKEY]",Error)
        end

    end)

end

