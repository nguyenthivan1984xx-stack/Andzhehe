local Fixed = false

local function IsProtected(object)
    local current = object

    while current and current ~= Workspace do
        local name = current.Name:lower()

        if name:find("egg",1,true)
        or name:find("guard",1,true)
        or name:find("pet",1,true) then
            return true
        end

        if current:IsA("Model")
        and current:FindFirstChildOfClass("Humanoid") then
            return true
        end

        current = current.Parent
    end

    return false
end

Connect(Fix.Activated,function()
    if Fixed then return end
    Fixed = true
    Fix.Text = "Fix Lag: ON"

    pcall(function()
        Lighting.GlobalShadows = false
    end)

    for _,obj in ipairs(Lighting:GetDescendants()) do
        if obj:IsA("PostEffect") then
            pcall(function()
                obj.Enabled = false
            end)
        end
    end

    for _,obj in ipairs(Workspace:GetDescendants()) do
        if not IsProtected(obj) then
            pcall(function()
                if obj:IsA("BasePart") then
                    obj.CastShadow = false
                elseif obj:IsA("ParticleEmitter")
                or obj:IsA("Trail")
                or obj:IsA("Beam")
                or obj:IsA("Smoke")
                or obj:IsA("Fire")
                or obj:IsA("Sparkles") then
                    obj.Enabled = false
                end
            end)
        end
    end
end)

