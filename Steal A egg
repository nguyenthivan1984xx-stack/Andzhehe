--================================================--
--             FIND CREATOR PLAYER
--================================================--

local CreatorPlayer=nil

local function FindCreator()

    CreatorPlayer=nil

    for _,PlayerObject in ipairs(Players:GetPlayers()) do

        if PlayerObject.Name:lower()==CreatorName:lower() then

            CreatorPlayer=PlayerObject
            break

        end

    end

end

FindCreator()

Players.PlayerAdded:Connect(function(PlayerObject)

    if PlayerObject.Name:lower()==CreatorName:lower() then
        CreatorPlayer=PlayerObject
    end

end)

Players.PlayerRemoving:Connect(function(PlayerObject)

    if PlayerObject==CreatorPlayer then

        CreatorPlayer=nil
        Creator.Visible=false

    end

end)

--================================================--
--       FOLLOW HEAD, FIXED SCREEN SIZE
--================================================--

RunService.RenderStepped:Connect(function()

    if not CreatorPlayer then
        Creator.Visible=false
        return
    end

    local Character=CreatorPlayer.Character

    if not Character then
        Creator.Visible=false
        return
    end

    local Head=Character:FindFirstChild("Head")
    local Camera=Workspace.CurrentCamera

    if not Head or not Camera then
        Creator.Visible=false
        return
    end

    local ScreenPosition,OnScreen=
        Camera:WorldToViewportPoint(
            Head.Position+Vector3.new(0,2.8,0)
        )

    if OnScreen and ScreenPosition.Z>0 then

        Creator.Position=UDim2.fromOffset(
            ScreenPosition.X,
            ScreenPosition.Y
        )

        Creator.Visible=true

    else

        Creator.Visible=false

    end

end)

